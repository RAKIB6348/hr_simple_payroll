<odoo>
  <data>
    <!-- Payslip list view -->
    <record model="ir.ui.view" id="view_hr_simple_payslip_list">
      <field name="name">hr.simple.payslip.list</field>
      <field name="model">hr.simple.payslip</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="date"/>
          <field name="amount"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Payslip form view -->
    <record model="ir.ui.view" id="view_hr_simple_payslip_form">
      <field name="name">hr.simple.payslip.form</field>
      <field name="model">hr.simple.payslip</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_generate_employees"
                    type="object"
                    string="Generate Employees"
                    class="oe_highlight"
                    invisible="state != 'draft'"/>
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="month"/>
                <field name="year"/>
              </group>
              <group>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="date"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount"/>
              </group>
            </group>
            <notebook>
              <page string="Employee Salary Lines" name="employee_salary_lines">
                <field name="line_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="employee_id"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="wage"/>
                  </tree>
                </field>
                <group>
                  <field name="total_wage"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Window action opened by the menu -->
    <record model="ir.actions.act_window" id="action_hr_simple_payslip">
      <field name="name">Payslips</field>
      <field name="res_model">hr.simple.payslip</field>
      <field name="view_mode">tree,form</field>
    </record>

    <!-- Root menu: Payroll -->
    <menuitem name="Payroll"
              id="menu_payroll_root"
              sequence="10"/>

    <!-- Submenu: Payslips -->
    <menuitem name="Payslips"
              id="menu_payroll_payslips"
              parent="menu_payroll_root"
              action="action_hr_simple_payslip"
              sequence="10"/>
  </data>
</odoo>
